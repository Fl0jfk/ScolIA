{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["app/**/{page,layout,route,loading,error,not-found}.{ts,tsx}", "proxy.ts", "next.config.ts"],
  "project": ["app/**/*.{ts,tsx}", "proxy.ts", "next.config.ts"],
  "ignore": [".next/**", "node_modules/**"],
  "ignoreBinaries": ["clerk"],
  "ignoreDependencies": [
    "@tailwindcss/postcss",
    "postcss",
    "tailwindcss",
    "server-only",
    "eslint",
    "eslint-config-next",
    "@eslint/eslintrc"
  ]
}
