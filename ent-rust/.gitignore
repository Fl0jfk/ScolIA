/target/
# Lockfiles : versionnés pour les deux workspaces applicatifs (reproductibilité, D-015).
# Les autres Cargo.lock éventuels (crates compilées isolément) restent ignorés.
Cargo.lock
!/Cargo.lock
!/web/Cargo.lock

# Object store local / buckets labo
.ent-objects/
.ent-objects-lab-*/

# Smoke / logs locaux (ne pas pousser)
*.log
*.err.log
login-*.json
body-*.json
bootstrap-*.json
reg-tmp.json
spa.js
spa-extract.js
check-spa-js.mjs
fix-home-tiles.mjs
lab-out*.txt
lab-err*.txt
lab-check*.txt

# Tailwind (deps locales ; CSS compilé versionné pour cargo run sans npm)
crates/ent-api/node_modules/

# Michelangelus (Microsoft download — ne pas committer les binaires)
crates/ent-api/static/fonts/*.ttf
crates/ent-api/static/fonts/*.otf
crates/ent-api/static/fonts/*.zip
crates/ent-api/static/fonts/*.rtf
scripts/michel-debug.html

# Sauvegardes logiques PRA (scripts/sauvegarde-postgres.sh) — jamais versionnées
/backups/
*.dump
*.dump.sha256
