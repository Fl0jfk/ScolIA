enuPlat: '',\n    menuPublie: false,\n    nMenusPublies: 0,\n    nMenusBrouillon: 0,\n  };\n  function paintCantineTips() {\n    const cgcEl = document.getElementById('cantPageCgcTip');\n    if (cgcEl) {\n      cgcEl.innerHTML = cantinePageCgcTipDenseHtml(cantineTipMeta);\n      bindCantinePageCgcTipActions(cantineTipMeta);\n    }\n    const pageEl = document.getElementById('cantPageTip');\n    if (pageEl) pageEl.innerHTML = cantinePageTipDenseHtml(cantineTipMeta);\n    const scanEl = document.getElementById('cantScanStatsTip');\n    if (scanEl) scanEl.innerHTML = cantineScanStatsTipDenseHtml(cantineTipMeta);\n    const refEl = document.getElementById('cantRefusTip');\n    if (refEl) refEl.innerHTML = cantineRefusTipDenseHtml(cantineTipMeta);\n    const menuEl = document.getElementById('cantMenuTip');\n    if (menuEl) menuEl.innerHTML = cantineMenuTipDenseHtml(cantineTipMeta);\n  }\n  await bindElevePickers('histEleve', 'histEleveQ', 'btnHistEleveSearch');\n  if (histFin.value && !histDebut.value) {\n    const d = new Date(histFin.value + 'T12:00:00');\n    d.setDate(d.getDate() - 14);\n    histDebut.value = d.toISOString().slice(0, 10);\n  }\n\n  async function loadActivites() {\n    const box = document.getElementById('actOut');\n    const sel = document.getElementById('grilleActCant');\n    try {\n      const list = await api('/repas/activites');\n      box.innerHTML = list.length\n        ? `<table><thead><tr><th>Code</th><th>Libellé</th><th>Kind</th><th></th></tr></thead>\n           <tbody>${list.map(a => `<tr>\n             <td>${esc(a.code)}</td><td>${esc(a.libelle)}</td>\n             <td><span class=\"pill\">${esc(a.kind)}</span></td>\n             <td>${a.actif ? 'actif' : 'off'}</td>\n           </tr>`).join('')}</tbody></table>`\n        : '<p class=\"empty\">Aucune activité.</p>';\n      if (sel) {\n        sel.innerHTML = list.map(a =>\n          `<option value=\"${esc(a.id)}\">${esc(a.libelle)} (${esc(a.kind)})</option>`\n        ).join('') || '<opti