oqué</strong> — ${rum}. Le prélèvement automatique est désactivé.`, 8000);\n}\n\n/** Élève /eleve/notes — période ouverte (saisie en cours, bulletin après fermeture). */\nfunction eleveNotePeriodeOuverteTipDenseHtml(periode) {\n  if (!periode || periode.statut !== 'ouverte') return '';\n  const label = esc(notePeriodeFermeeLabel(periode));\n  const dates = periode.date_debut && periode.date_fin\n    ? `${esc(String(periode.date_debut))} → ${esc(String(periode.date_fin))}`\n    : '—';\n  return `<div class=\"bento\" style=\"margin:0 0 .65rem\">\n    <div class=\"stat-tile bento-span-4\" style=\"border-color:var(--accent,#0071e3)\">\n      <strong class=\"ok\">Ouverte</strong><span>Période ${label} ${notePeriodeStatutBadge('ouverte')}</span>\n    </div>\n    <div class=\"stat-tile bento-span-4\"><strong>${dates}</strong><span>Notes saisies au fil de la période</span></div>\n    <div class=\"stat-tile bento-span-4\"><strong class=\"muted\">Bulletin</strong><span>PDF après fermeture par l’établissement</span></div>\n  </div>`;\n}\n\n/** Élève /eleve/notes — période fermée (bulletin publiable). */\nfunction eleveNotePeriodeFermeeTipDenseHtml(periode) {\n  if (!periode || periode.statut !== 'fermee') return '';\n  const label = esc(notePeriodeFermeeLabel(periode));\n  const dates = periode.date_debut && periode.date_fin\n    ? `${esc(String(periode.date_debut))} → ${esc(String(periode.date_fin))}`\n    : '—';\n  return `<div class=\"bento\" style=\"margin:0 0 .65rem\">\n    <div class=\"stat-tile bento-span-4\" style=\"border-color:var(--ok,#16a34a)\">\n      <strong class=\"ok\">Fermée</strong><span>Période ${label} ${notePeriodeStatutBadge('fermee')}</span>\n    </div>\n    <div class=\"stat-tile bento-span-4\"><strong>${dates}</strong><span>Notes figées · moyennes finalisées</span></div>\n    <button type=\"button\" class=\"stat-tile bento-span-4\" id=\"eleveNotePeriodePrintTipBtn\" style=\"cursor:pointer;text-align:left;border-color:var(--accent,#0071e3)\">\n      <strong>Imprimer</strong><span>Bulletin PDF · télécharger puis dialogue d’impression</span>\n    </button>\n  </div>`;\n}\n\nfunction bindEleveNotePeriodePrintTip() {\n  const btn = document.getElementById('eleveNotePeriodePrintTipBtn');\n  if (!btn) return;\n  btn.onclick = () => {\n    if (entOpenBulletinPrintDialog()) return;\n    document.getElementById('btnEleveBulletin')?.click();\n  };\n}\n\nfunction isLabSeamusEleveSession() {\n  if (!me || !isEleve()) return false;\n  return /^seamus$/i.test(String(me.prenom || '').trim())\n    && /finnigan/i.test(String(me.nom || '').trim());\n}\n\nfunction isLabLunaEleveSession() {\n  if (!me || !isEleve()) return false;\n  return /^luna$/i.test(String(me.prenom || '').trim())\n    && /lovegood/i.test(String(me.nom || '').trim());\n}\n\n/** Élève /eleve/notes — liste vide · repère seed labo Luna Lovegood (BS-D / BS-A). */\nfunction eleveNotesLunaSeedTipDenseHtml(classe, meta) {\n  const o = meta || {};\n  const cl = esc(String(classe || '6A').trim());\n  const hasBsNote = !!o.hasBsNote;\n  const noteLbl = o.bsNoteLabel\n    ? esc(String(o.bsNoteLabel).trim().slice(0, 28))\n    : 'Potions BS-A';\n  return `<div class=\"bento\" style=\"margin:.15rem 0 .45rem\">\n    <div class=\"stat-tile bento-span-4\" style=\"border-color:var(--accent,#0071e3)\">\n      <strong>Luna Lovegood</strong><span>Seed labo · ${cl} · audit portail BS-D</span>\n    </div>\n    <div class=\"stat-tile bento-span-4\"><strong class=\"${hasBsNote ? 'ok' : 'muted'}\">${noteLbl}</strong><span>${hasBsNote ? 'Note BS-A publiée' : 'En attente saisie prof'}</span></div>\n    <a class=\"stat-tile bento-span-4\" href=\"/eleve/cahier\" style=\"text-decoration:none;border-color:var(--accent,#0071e3)\">\n      <strong>Cahier</strong><span>Devoirs quotidiens · en attendant</span>\n    </a>\n  </div>`;\n}\n\n/** Élève /eleve/notes — liste vide · repère seed labo Seamus Finnigan (6A). */\nfunction eleveNotesSeamusSeedTipDenseHtml(classe) {\n  const cl = esc(String(classe || '6A').trim());\n  return `<div class=\"bento\" style=\"margin:.15rem 0 .45rem\">\n    <div class=\"stat-tile bento-span-4\" style=\"border-color:var(--accent,#0071e3)\">\n      <strong>Seamus Finnigan</strong><span>Seed labo · ${cl} · audit portail notes</span>\n    </div>\n    <div class=\"stat-tile bento-span-4\"><strong class=\"muted\">Potions</strong><span>Interro lab · après publication prof</span></div>\n    <a class=\"stat-tile bento-span-4\" href=\"/eleve/cahier\" style=\"text-decoration:none;border-color:var(--accent,#0071e3)\">\n      <strong>Cahier</strong><span>Devoirs quotidiens · en attendant</span>\n    </a>\n  </div>`;\n}\n\nfunction eleveNotesListEmptyTipDenseHtml(periode) {\n  if (!periode) return '';\n  const label = esc(notePeriodeFermeeLabel(periode));\n  const fermee = periode.statut === 'fermee';\n  const printTile = fermee\n    ? `<button type=\"button\" class=\"stat-tile bento-span-4\" id=\"eleveNotesEmptyPrintTipBtn\" style=\"cursor:pointer;text-align:left;border-color:var(--accent,#0071e3)\">\n        <strong>Imprimer</strong><span>Bulletin · après téléchargement</span></button>`\n    : `<div class=\"stat-tile bento-span-4\"><strong class=\"muted\">Bulletin</strong><span>PDF après fermeture de période</span></div>`;\n  return `<div class=\"bento\" style=\"margin:0 0 .55rem\">\n    <div class=\"stat-tile bento-span-4\"><strong class=\"warn\">0</strong><span>Note publiée · ${label}</span></div>\n    <div class=\"stat-tile bento-span-4\"><strong class=\"muted\">Prof</strong><span>Saisie au fil des cours et devoirs</span></div>\n    ${printTile}\n  </div>`;\n}\n\nfunction bindEleveNotesListEmptyPrintTip() {\n  const btn = document.getElementById('eleveNotesEmptyPrintTipBtn');\n  if (!btn) return;\n  btn.onclick = () => {\n    if (entOpenBulletinPrintDialog()) return;\n    document.getElementById('btnEleveBulletin')?.click();\n  };\n}\n\nfunction refreshEleveNotesListEmptyTip(periode, notes) {\n  const el = document.getElementById('eleveNo