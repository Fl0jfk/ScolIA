l;\n        toastFamPaiementSimule(fac, reste);\n      };\n    }\n  }\n  function wireFacFamChips() {\n    const chipAll = document.getElementById('facFamChipAll');\n    const chipEm = document.getElementById('facFamChipEmises');\n    const chipSol = document.getElementById('facFamChipSoldees');\n    if (chipAll) {\n      chipAll.onclick = () => {\n        const prev = facFamFilter;\n        facFamFilter = 'all';\n        paintFacFamList();\n        maybeToastFacFamFilterFromUi(prev, facFamFilter, facFamSortedList, facFamFilteredList(facFamSortedList));\n      };\n    }\n    if (chipEm) {\n      chipEm.onclick = () => {\n        const prev = facFamFilter;\n        facFamFilter = 'emises';\n        paintFacFamList();\n        maybeToastFacFamFilterFromUi(prev, facFamFilter, facFamSortedList, facFamFilteredList(facFamSortedList));\n      };\n    }\n    if (chipSol) {\n      chipSol.onclick = () => {\n        const prev = facFamFilter;\n        facFamFilter = 'soldees';\n        paintFacFamList();\n        maybeToastFacFamFilterFromUi(prev, facFamFilter, facFamSortedList, facFamFilteredList(facFamSortedList));\n      };\n    }\n  }\n  async function resolveFoyerId() {\n    const enfants = await api('/famille/enfants').catch(() => []);\n    for (const e of (enfants || [])) {\n      const d = await api('/eleves/' + e.id + '/dossier').catch(() => null);\n      const lien = ((d && d.liens) || []).find(l => l.foyer_id);\n      if (lien && lien.foyer_id) return lien.foyer_id;\n    }\n    const facs = await api('/facturation/famille').catch(() => []);\n    if (facs && facs[0] && facs[0].foyer_id) return facs[0].foyer_id;\n    return null;\n  }\n  async function loadFacQuotient() {\n    const box = document.getElementById('facQuoOut');\n    if (!box) return null;\n    box.textContent = 'Chargement…';\n    try {\n      const fid = await resolveFoyerId();\n      if (!fid) { box.innerHTML = '<span class=\"bad\">Aucun foyer lié</span>'; return null; }\n      const annee = (documen