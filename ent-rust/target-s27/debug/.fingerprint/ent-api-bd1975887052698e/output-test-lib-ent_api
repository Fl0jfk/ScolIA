span class=\"pill\">${esc(d.statut || '—')}</span></td>\n           </tr>`).join('')}</tbody></table>\n           <p class=\"muted\">${actives.length} active(s)</p>`;\n    } catch (e) {\n      dispOut.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n    }\n  }\n  await loadEleveDispVs();\n  const btnDv = document.getElementById('btnEleveDvPose');\n  if (btnDv) {\n    btnDv.onclick = async () => {\n      const msg = document.getElementById('eleveDvMsg');\n      try {\n        const d = await api('/eleves/' + eid + '/dispenses-vs', {\n          method: 'POST',\n          body: JSON.stringify({\n            motif: (document.getElementById('eleveDvMotif') || {}).value || 'eps',\n            debut: (document.getElementById('eleveDvDebut') || {}).value || today(),\n            fin: (document.getElementById('eleveDvFin') || {}).value || today(),\n            commentaire: ((document.getElementById('eleveDvCom') || {}).value || '').trim() || 'Demande élève',\n          }),\n        });\n        if (msg) msg.innerHTML = `<span class=\"ok\">Dispense ${esc(d.motif)} demandée</span>`;\n        toastEleveDispenseDemandee(d, { dense: true });\n        await loadEleveDispVs();\n      } catch (err) {\n        if (msg) msg.innerHTML = `<span class=\"bad\">${esc(err.message)}</span>`;\n      }\n    };\n  }\n  const infOut = document.getElementById('eleveInfOut');\n  if (infOut) {\n    try {\n      const list = await api('/infirmerie/passages?eleve_id=' + encodeURIComponent(eid));\n      nPassagesTip = (list || []).length;\n      passagesApiOk = true;\n      refreshEleveSantePageTip({\n        fiche: ficheForTip,\n        ficheApiOk,\n        nPassages: nPassagesTip,\n        passagesApiOk,\n        nDispActive: nDispActiveTip,\n      });\n      infOut.innerHTML = !(list || []).length\n        ? '<p class=\"empty\">Aucun passage visible.</p>'\n        : `<ul>${list.map(p =>\n            `<li>${esc(p.jour)} — ${esc(p.motif_libelle || p.motif)}${p.note_soins ? ' · ' + esc(p.note_soins) : ''}</li>`\n          ).join('')}</ul>`;\n    } catch (e) {\n      infOut.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n    }\n  }\n}\n\nfunction viewEleveJournal() {\n  return shell('/eleve/journal', `\n    <div class=\"bento\" id=\"eleveJourStats\"></div>\n    <div class=\"panel\">\n      <h2>Mon journal</h2>\n      <p class=\"muted\">Entrées visibles famille (même filtre que le portail parent).</p>\n      <div id=\"eleveJourOut\" class=\"muted\">Chargement…</div>\n    </div>`);\n}\n\nasync function bindEleveJournal() {\n  const out = document.getElementById('eleveJourOut');\n  const stats = document.getElementById('eleveJourStats');\n  const eid = me && me.eleve_id;\n  if (!eid) { out.innerHTML = '<p class=\"empty\">eleve_id manquant</p>'; return; }\n  try {\n    const list = await api('/eleves/' + eid + '/journal?limit=50');\n    const byDom = {};\n    (list || []).forEach(j => {\n      const d = j.domaine || 'autre';\n      byDom[d] = (byDom[d] || 0) + 1;\n    });\n    if (stats) {\n      const keys = Object.keys(byDom);\n      stats.innerHTML = `\n        <div class=\"stat-tile bento-span-3\"><strong>${list.length}</strong><span>Entrées</span></div>\n        ${keys.slice(0, 3).map(k =>\n          `<div class=\"stat-tile bento-span-3\"><strong>${byDom[k]}</strong><span>${esc(k)}</span></div>`\n        ).join('')}`;\n    }\n    if (!list.length) {\n      out.innerHTML = '<p class=\"empty\">Aucune entrée visible.</p>';\n      return;\n    }\n    const groups = {};\n    list.forEach(j => {\n      const d = j.domaine || 'autre';\n      if (!groups[d]) groups[d] = [];\n      groups[d].push(j);\n    });\n    out.innerHTML = Object.keys(groups).sort().map(dom => `\n      <h3 style=\"margin:1rem 0 .4rem\">${esc(dom)}</h3>\n      <ul>${groups[dom].map(j =>\n        `<li><strong>${esc(j.libelle)}</strong> <span class=\"muted\">${esc((j.created_at || '').slice(0, 16))}</span></li>`\n      ).join('')}</ul>`).join('');\n  } catch (e) {\n    out.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n  }\n}\n\nfunction viewEleveDocs() {\n  return shell('/eleve/docs', `\n    <div class=\"bento\" id=\"eleveDocsStats\"></div>\n    <div id=\"eleveDocsPageTip\"></div>\n    <div class=\"panel\">\n      <h2>Bulletins</h2>\n      <p class=\"muted\">PDF publiés après fermeture de période (ex. BULLETIN_T0) — distinct des pièces à signer.</p>\n      <div id=\"eleveDocsBulletinsOut\" class=\"muted\">Chargement…</div>\n    </div>\n    <div class=\"panel\">\n      <h2>Documents à signer</h2>\n      <p class=\"muted\">Règlement, chartes et pièces VS en attente de votre signature.</p>\n      <div id=\"eleveDocsOut\" class=\"muted\">Chargement…</div>\n    </div>\n    <div class=\"panel\">\n      <h2>Carnet</h2>\n      <div id=\"eleveCarnetOut\" class=\"muted\">Chargement…</div>\n    </div>`);\n}\n\nasync function bindEleveDocs() {\n  const out = document.getElementById('eleveDocsOut');\n  const bulOut = document.getElementById('eleveDocsBulletinsOut');\n  const carOut = document.getElementById('eleveCarnetOut');\n  const stats = document.getElementById('eleveDocsStats');\n  const eid = me && me.eleve_id;\n  if (!eid) { out.innerHTML = '<p class=\"empty\">eleve_id manquant</p>'; return; }\n  function bulletinDocCode(d) {\n    return String(d.code || '').trim().toUpperCase();\n  }\n  function isBulletinMetierDoc(d) {\n    if (!d || !d.accessible) return false;\n    const code = bulletinDocCode(d);\n    if (code.startsWith('BULLETIN_')) return true;\n    return /bulletin/i.test(d.titre || '') || /bulletin/i.test(d.code || '');\n  }\n  try {\n    const [docs, carnet, metierDocs] = await Promise.all([\n      api('/eleves/' + eid + '/docs-a-signer'),\n      api('/eleves/' + eid + '/carnet').catch(() => []),\n      api('/eleves/' + eid + '/documents').catch(() => []),\n    ]);\n    const pendingDocs = (docs || []).filter(d => !d.signe_at);\n    const pendingCar = (carnet || []).filter(c => !c.signe_at);\n    const bulletins = (metierDocs || []).filter(isBulletinMetierDoc);\n    const bulletinT0 = bulletins.some(d => bulletinDocCode(d) === 'BULLETIN_T0');\n    if (stats) {\n      stats.innerHTML = `\n        <div class=\"stat-tile bento-span-3\"><strong class=\"${pendingDocs.length ? 'warn' : ''}\">${pendingDocs.length}</strong><span>Docs à signer</span></div>\n        <div class=\"stat-tile bento-span-3\"><strong class=\"${pendingCar.length ? 'warn' : ''}\">${pendingCar.length}</strong><span>Carnet à signer</span></div>\n        <div class=\"stat-tile bento-span-3\"><strong class=\"${bulletins.length ? 'ok' : ''}\">${bulletins.length}</strong><span>Bulletin(s)</span></div>\n        ${bulletinT0 ? '<div class=\"stat-tile bento-span-3\"><strong>T0</strong><span>Trimestre 0</span></div>' : ''}`;\n    }\n    refreshEleveDocsPageTip(pendingDocs, pendingCar);\n    if (bulOut) {\n      if (!bulletins.length) {\n        bulOut.innerHTML = emptyState(\n          'Aucun bulletin publié',\n          'Les bulletins apparaissent ici après publication par l’établissement (période fermée, ex. BULLETIN_T0).'\n        );\n      } else {\n        const sorted = bulletins.slice().sort((a, b) => {\n          const ca = bulletinDocCode(a);\n          const cb = bulletinDocCode(b);\n          if (ca === 'BULLETIN_T0') return -1;\n          if (cb === 'BULLETIN_T0') return 1;\n          return (b.titre || '').localeCompare(a.titre || '', 'fr');\n        });\n        bulOut.innerHTML = `<ul style=\"margin:.35rem 0 0;padding-left:1.1rem\">${sorted.map(d => {\n          const code = bulletinDocCode(d);\n          const t0 = code === 'BULLETIN_T0';\n          return `<li style=\"margin:.35rem 0\">\n            <strong>${esc(d.titre || code || 'Bulletin')}</strong>\n            ${code ? `<span class=\"pill${t0 ? ' ok' : ''}\">${esc(code)}</span>` : ''}\n            <button type=\"button\" class=\"btnEleveDocsBulDl\" data-id=\"${esc(d.id)}\" data-titre=\"${esc(d.titre || code || 'bulletin.pdf')}\">Télécharger</button>\n          </li>`;\n        }).join('')}</ul>`;\n        bulOut.querySelectorAll('.btnEleveDocsBulDl').forEach(btn => {\n          btn.onclick = async () => {\n            try {\n              await downloadBulletinFile('/documents/' + btn.dataset.id + '/fichier', btn.dataset.titre || 'bulletin.pdf');\n              toastBulletinTelecharge(btn.dataset.titre || 'PDF', { code: btn.dataset.titre || 'PDF' });\n            } catch (err) { alert(err.message); }\n          };\n        });\n      }\n    }\n    await renderDocsASignerTable(out, pendingDocs, () => bindEleveDocs(), eid);\n    if (carOut) {\n      carOut.innerHTML = !(carnet || []).length\n        ? emptyState('Aucune entrée carnet', 'Les sanctions et entrées VS à signer apparaissent ici.')\n        : `<table><thead><tr><th>Date</th><th>Titre</th><th>Catégorie</th><th></th></tr></thead>\n           <tbody>${(carnet || []).map(c => `<tr>\n             <td>${esc(c.date_entree)}</td>\n             <td>${esc(c.titre)}</td>\n             <td class=\"muted\">${esc(c.categorie || '—')}</td>\n             <td>${c.signe_at\n               ? '<span class=\"ok\">signé</span>'\n               : `<button type=\"button\" class=\"primary btnEleveCarDoc\" data-id=\"${esc(c.id)}\" data-titre=\"${esc(c.titre || '')}\" data-categorie=\"${esc(c.categorie || 'carnet')}\">Signer</button>`}</td>\n           </tr>`).join('')}</tbody></table>`;\n      carOut.querySelectorAll('.btnEleveCarDoc').forEach(btn => {\n        btn.onclick = async () => {\n          try {\n            await apiSignCarnetWithToast(btn, carnet, { portal: 'eleve' });\n            await bindEleveDocs();\n          } catch (err) { alert(err.message); }\n        };\n      });\n    }\n  } catch (e) {\n    out.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n  }\n}\n\nfunction viewEleveRepas() {\n  return shell('/eleve/repas', `\n    <div class=\"bento\" id=\"eleveRepasStats\"></div>\n    <div class=\"panel\">\n      <h2>Mes repas</h2>\n      <p class