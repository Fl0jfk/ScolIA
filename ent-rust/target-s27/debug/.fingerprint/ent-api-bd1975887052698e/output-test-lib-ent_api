>`;\n          photosLoaded += 1;\n        } catch {}\n      }\n      const summaryEl = trombiOut.querySelector('[data-trombi-summary]');\n      if (summaryEl) {\n        const loadHint = avecPhoto\n          ? ` · ${photosLoaded}/${avecPhoto} photo(s) chargée(s)`\n          : '';\n        summaryEl.innerHTML = `${list.length} élève(s) · ${avecPhoto} photo(s) en base${loadHint}${missHint}`;\n      }\n    } catch (e) {\n      trombiOut.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n    }\n  }\n  document.getElementById('btnTrombi').onclick = loadTrombi;\n  document.getElementById('trombiClasse').onchange = () => {\n    const cl = document.getElementById('trombiClasse').value.trim() || '4B';\n    refreshTrombiPageTip(cl, !trombiAutoLoad && trombiOut && !trombiOut.querySelector('#trombiGrid'));\n    loadTrombi();\n  };\n  document.getElementById('trombiClasse').onkeydown = (ev) => {\n    if (ev.key === 'Enter') loadTrombi();\n  };\n  function applyTrombiDeepLink() {\n    try {\n      const params = new URLSearchParams(window.location.search || '');\n      const trombi = params.get('trombi');\n      if (trombi) {\n        const inp = document.getElementById('trombiClasse');\n        if (inp) inp.value = trombi;\n      }\n      if (trombi || (window.location.hash || '') === '#trombi') {\n        const panel = document.getElementById('panelTrombi');\n        if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      }\n    } catch { /* ignore */ }\n  }\n  function bindTrombiEmptyLoadBtn() {\n    const btn = document.getElementById('btnTrombiEmptyLoad');\n    if (btn) btn.onclick = () => loadTrombi();\n  }\n  applyTrombiDeepLink();\n  let trombiAutoLoad = false;\n  try {\n    const params = new URLSearchParams(window.location.search || '');\n    trombiAutoLoad = !!(params.get('trombi') || (window.location.hash || '') === '#trombi');\n  } catch { /* ignore */ }\n  if (trombiAutoLoad) {\n    await loadTrombi();\n  } else if (trombiOut) {\n