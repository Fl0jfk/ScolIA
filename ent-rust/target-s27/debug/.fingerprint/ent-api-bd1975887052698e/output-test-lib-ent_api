e <select id=\"expPeriode\"></select></label>\n        <label>Année (Parcoursup) <input id=\"expAnnee\" value=\"2026-2027\" style=\"width:8rem\"/></label>\n        <button type=\"button\" id=\"btnExpLsl\">LSL</button>\n        <button type=\"button\" id=\"btnExpLsun\">LSUN</button>\n        <button type=\"button\" id=\"btnExpNotanet\">Notanet</button>\n        <button type=\"button\" id=\"btnExpParcoursup\">Parcoursup</button>\n        <button type=\"button\" id=\"btnExpOnde\">ONDE</button>\n      </div>\n      <div id=\"expMsg\" class=\"muted\"></div>\n    </div>`);\n}\n\nasync function bindNotes() {\n  suppressNotePeriodePickToast();\n  function focusNotesStep(step) {\n    const targets = {\n      1: 'btnNewPeriode',\n      2: 'btnMatCreer',\n      3: 'btnDevCreer',\n      4: 'btnSaisirNote',\n    };\n    const id = targets[step];\n    const el = id ? document.getElementById(id) : null;\n    if (el) {\n      el.scrollIntoView({ behavior: 'smooth', block: 'center' });\n      el.focus({ preventScroll: true });\n    }\n  }\n  function focusGrillePanel(preferInput) {\n    const panel = document.getElementById('notesGrillePanel');\n    const box = document.getElementById('grilleOut');\n    if (panel) {\n      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });\n      panel.focus({ preventScroll: true });\n    } else if (box) {\n      box.scrollIntoView({ behavior: 'smooth', block: 'start' });\n    }\n    if (!preferInput || !box) return;\n    requestAnimationFrame(() => {\n      const first = box.querySelector('.grilleNote, button.primary, button');\n      if (first && typeof first.focus === 'function') first.focus({ preventScroll: true });\n    });\n  }\n  function bindNotesGuideClicks(root) {\n    if (!root) return;\n    root.querySelectorAll('[data-notes-step]').forEach(btn => {\n      btn.onclick = (ev) => {\n        ev.preventDefault();\n        focusNotesStep(Number(btn.getAttribute('data-notes-step')));\n      };\n    });\n  }\n  async function fillEle