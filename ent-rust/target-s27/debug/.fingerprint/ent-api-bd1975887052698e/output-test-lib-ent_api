? 'Matière' : 'Générale'))}</span> ${esc(a.texte)}${a.auteur_label ? ' <span class=\"muted\">· ' + esc(a.auteur_label) + '</span>' : ''}</li>`\n        ).join('')}</ul>`\n      : famEmptyDense('Aucune appréciation', [\n          `Période ${esc(p.libelle || '')} — les appréciations des professeurs apparaissent après saisie ou fermeture.`,\n          'Consultez aussi les décisions de conseil ci-dessous.',\n        ], '<a href=\"/eleve/vie-scolaire\">Vie scolaire</a>');\n  } catch (e) {\n    moyOut.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n  }\n  const encSpot = document.getElementById('eleveEncouragementsSpot');\n  if (conseilOut || encSpot) {\n    try {\n      const list = await api('/eleves/' + eid + '/conseils');\n      const vis = (list || []).filter(c => c.visible_famille !== false);\n      if (encSpot) encSpot.innerHTML = eleveNotesEncouragementsHtml(vis);\n      const autres = vis.filter(c => String(c.mention || '').toLowerCase() !== 'encouragements');\n      if (conseilOut) {\n        conseilOut.innerHTML = autres.length\n          ? `<ul>${autres.map(c =>\n              `<li>${esc(c.mention || 'Décision')} — ${esc(c.appreciation || '')}${c.classe ? ' · ' + esc(c.classe) : ''}</li>`\n            ).join('')}</ul>`\n          : vis.length\n            ? emptyState('Pas d’autre décision de conseil', 'Les encouragements sont affichés ci-dessus.')\n            : emptyState('Aucune décision de conseil visible', 'Voir aussi la vie scolaire.');\n      }\n    } catch (e) {\n      if (encSpot) encSpot.innerHTML = '';\n      if (conseilOut) conseilOut.innerHTML = emptyState('Décisions indisponibles', esc(e.message));\n    }\n  }\n  eleveNotePeriodePickReady = true;\n  }\n  function isNotePeriodeT0(p) {\n    if (!p) return false;\n    const code = String(p.code || '').trim().toUpperCase();\n    if (code === 'T0' || code === 'TRIM0') return true;\n    const lb = String(p.libelle || '').toLowerCase();\n    return /\\btrim(estre)?\\s*0\\b/.test(lb) || /\\bt0\\b/.test(lb);\n  }\n  function eleveBulletinT0TipHtml() {\n    return '<span class=\"empty-state-hint\">Trimestre 0 — bulletin PDF publié sous le code <strong>BULLETIN_T0</strong> après fermeture de période.</span>';\n  }\n  function updateEleveBulletinHint(periode) {\n    const hint = document.getElementById('eleveBulletinHint');\n    const btn = document.getElementById('btnEleveBulletin');\n    if (!hint) return;\n    if (!periode) {\n      hint.innerHTML = '';\n      if (btn) btn.disabled = false;\n      return;\n    }\n    const t0Tip = isNotePeriodeT0(periode) ? `<br/>${eleveBulletinT0TipHtml()}` : '';\n    if (periode.statut === 'fermee') {\n      hint.innerHTML = `<span class=\"ok\">Période fermée — le bulletin peut être téléchargé s’il a été publié.</span>${t0Tip}`;\n      if (btn) btn.disabled = false;\n    } else {\n      hint.innerHTML = `<span class=\"warn\">Bulletin disponible après fermeture de la période par l’établissement (période encore ouverte ou en cours).</span>${t0Tip}`;\n      if (btn) btn.disabled = false;\n    }\n  }\n  const btnBul = document.getElementById('btnEleveBulletin');\n  if (btnBul) {\n    btnBul.onclick = async () => {\n      const msg = document.getElementById('eleveBulletinMsg');\n      try {\n        const periodes = await api('/note-periodes').catch(() => []);\n        const sel = document.getElementById('eleveNotePeriode');\n        const pid = (sel && sel.value) || '';\n        const periode = (periodes || []).find(x => x.id === pid);\n        if (periode && periode.statut !== 'fermee') {\n          if (msg) {\n            msg.innerHTML = '<span class=\"warn\">Le bulletin n’est publié qu’une fois la période fermée. Période « ' + esc(periode.libelle || periode.code || '') + ' » : ' + esc(periode.statut || 'ouverte') + '.</span>';\n          }\n          if (sel) sel.focus({ preventScroll: true });\n          return;\n        }\n        const docs = await api('/eleves/' + eid + '/documents');\n        const bulletins = (docs || []).filter(isBulletinMetierDoc);\n        if (!bulletins.length) {\n          if (msg) msg.innerHTML = '<span class=\"bad\">Aucun bulletin accessible (attendu ex. BULLETIN_T0)</span>';\n          return;\n        }\n        const plabel = sel && sel.options[sel.selectedIndex] ? sel.options[sel.selectedIndex].text : '';\n        const pcode = (periode && periode.code) ? String(periode.code).trim().toUpperCase() : '';\n        let doc = bulletins[0];\n        if (pcode) {\n          const byCode = bulletins.find(d => bulletinDocCode(d) === 'BULLETIN_' + pcode);\n          if (byCode) doc = byCode;\n        }\n        if (plabel && doc === bulletins[0]) {\n          const hit = bulletins.find(d => (d.titre || '').includes(plabel.split('—')[0].trim())\n            || (d.titre || '').toLowerCase().includes((plabel || '').toLowerCase().slice(0, 8)));\n          if (hit) doc = hit;\n        }\n        await downloadBulletinFile('/documents/' + doc.id + '/fichier', doc.titre || 'bulletin.pdf');\n        toastBulletinTelecharge(doc.titre || 'Bulletin', { code: bulletinDocCode(doc) || doc.titre || 'Bulletin' });\n        if (msg) msg.innerHTML = `<span class=\"ok\">${esc(doc.titre)}</span>`;\n      } catch (err) {\n        if (msg) msg.innerHTML = `<span class=\"bad\">${esc(err.message)}</span>`;\n      }\n    };\n  }\n  await loadNotesAll();\n}\n\nfunction viewEleveEdt() {\n  return shell('/eleve/edt', `\n    <div class=\"bento\" id=\"eleveEdtStats\"></div>\n    <div class=\"panel\">\n      <h2>Emploi du temps</h2>\n      <div class=\"row edt-toolbar\">\n        <label>Semaine (lundi) <input id=\"eleveEdtJour\" type=\"date\" value=\"${mondayOf(today())}\"/></label>\n        <button type=\"button\" class=\"primary\" id=\"btnEleveEdt\">Semaine</button>\n        <button type=\"button\" id=\"btnEleveEdtPrev\">←</button>\n        <button type=\"button\" id=\"btnEleveEdtNext\">→</button>\n        <button type=\"button\" id=\"btnEleveEdtJour\">Jour seul</button>\n        <button type=\"button\" class=\"primary edt-ical-btn\" id=\"btnEleveEdtIcal\">Exporter iCal (semaine)</button>\n      </div>\n      <div id=\"eleveVacBanner\" class=\"muted\" style=\"margin-top:.35rem\"></div>\n      <div id=\"eleveEdtOut\" class=\"muted\" style=\"margin-top:.75rem\">…</div>\n    </div>\n    <div class=\"panel\">\n      <h3>Vacances / fermetures</h3>\n      <div id=\"eleveVacList\" class=\"muted\">…</div>\n    </div>`);\n}\n\nasync function bindEleveEdt() {\n  const eid = me && me.eleve_id;\n  const out = document.getElementById('eleveEdtOut');\n  const stats = document.getElementById('eleveEdtStats');\n  const joursLib = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'];\n  async function loadVacList() {\n    const box = document.getElementById('eleveVacList');\n    if (!box) return;\n    try {\n      const list = await api('/vacances');\n      box.innerHTML = !(list || []).length\n        ? '<p class=\"empty\">Aucune période publiée.</p>'\n        : `<ul>${list.slice(0, 12).map(v =>\n            `<li><strong>${esc(v.libelle || v.kind || 'fermeture')}</strong> · ${esc(v.debut)} → ${esc(v.fin)}</li>`\n          ).join('')}</ul>`;\n    } catch (e) {\n      box.innerHTML = `<p class=\"empty\">${esc(e.message)}</p>`;\n    }\n  }\n  function wireEleveEdtSemaineEmptyActions() {\n    const runIcal = () => document.getElementById('btnEleveEdtIcal')?.click();\n    const tipIcal = document.getElementById('eleveEdtSemaineTipIcal');\n    if (tipIcal) tipIcal.onclick = runIcal;\n    const emptyIcal = document.getElementById('eleveEdtSemaineEmptyIcal');\n    if (emptyIcal) emptyIcal.onclick = runIcal;\n    const emptyJour = document.getElementById('eleveEdtSemaineEmptyJour');\n    if (emptyJour) emptyJour.onclick = () => loadJourSeul();\n  }\n  async function loadJourSeul() {\n    if (!eid) { out.innerHTML = '<p class=\"empty\">eleve_id manquant</p>'; return; }\n    const jour = document.getElementById('eleveEdtJour').value || today();\n    try {\n      const [list, ferme] = await Promise.all([\n        api('/eleves/' + eid + '/edt?jour=' + encodeURIComponent(jour)),\n        api('/vacances/jour-ferme?jour=' + encodeURIComponent(jour)).catch(() => ({ ferme: false })),\n      ]);\n      const ban = document.getElementById('eleveVacBanner');\n      if (ban) {\n        ban.innerHTML = ferme && ferme.ferme\n          ? '<p class=\"warn\" style=\"margin:0\">Jour fermé (vacances / férié)</p>'\n          : '';\n      }\n      if (stats) {\n        const scan = eleveEdtPickCurrentAndNext([list], [jour]);\n        stats.innerHTML = eleveEdtTipDenseHtml({\n          mode: 'jour',\n          jour,\n          nCours: list.length,\n          current: scan.current,\n          next: scan.next,\n        });\n      }\n      out.innerHTML = !list.length\n        ? (isIsoWeekend(jour)\n          ? eleveEdtWeekendEmptyHtml(jour)\n          : emptyState('Aucun cours ce jour', 'Changez de date ou affichez la semaine complète.'))\n        : `<ul>${list.map(c =>\n            `<li class=\"edt-slot${edtSlotNowClass(jour, c.heure_debut, c.heure_fin)}\">${esc(c.heure_debut)}–${esc(c.heure_fin)} · ${esc(c.matiere_libelle)} · ${esc(c.salle || '—')}</li>`\n          ).join('')}</ul>`;\n    } catch (e) {\n      out.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n    }\n  }\n  async function load() {\n    if (!eid) { out.innerHTML = '<p class=\"empty\">eleve_id manquant</p>'; return; }\n    const lundi = mondayOf(document.getElementById('eleveEdtJour').value || today());\n    document.getElementById('eleveEdtJour').value = lundi;\n    out.textContent = 'Chargement…';\n    try {\n      const jours = [0, 1, 2, 3, 4, 5, 6].map(i => addDaysIso(lundi, i));\n      const [lists, fermes] = await Promise.all([\n        Promise.all(jours.map(j =>\n          api('/eleves/' + eid + '/edt?jour=' + encodeURIComponent(j)).catch(() => [])\n        )),\n        Promise.all(jours.map(j =>\n          api('/vacances/jour-ferme?jour=' + encodeURIComponent(j)).catch(() => ({ jour: j, ferme: false }))\n        )),\n      ]);\n      const total = lists.reduce((s, l) => s + (l || []).length, 0);\n      const nFerme = fermes.filter(f => f && f.ferme).length;\n      if (stats) {\n        const scan = eleveEdtPickCurrentAndNext(lists, jours);\n        stats.innerHTML = eleveEdtTipDenseHtml({\n          mode: 'semaine',\n          lundi,\n          total,\n          nFerme,\n          current: scan.current,\n          next: scan.next,\n        });\n      }\n      const ban = document.getElementById('eleveVacBanner');\n      if (ban) {\n        ban.innerHTML = nFerme\n          ? `<p class=\"warn\" style=\"margin:0\">${nFerme} jour(s) fermé(s) cette semaine</p>`\n          : '';\n      }\n      const totalWeekday = lists.slice(0, 5).reduce((s, l) => s + (l || []).length, 0);\n      if (!totalWeekday) {\n        if (stats) stats.innerHTML = eleveEdtSemaineEmptyTipDenseHtml(lundi, nFerme);\n        out.innerHTML = eleveEdtSemaineEmptyHtml(lundi);\n        wireEleveEdtSemaineEmptyActions();\n        return;\n      }\n      out.innerHTML = `<div class=\"edt-week edt-week-eleve\">${jours.map((j, i) => {\n        const slots = [...(lists[i] || [])].sort((a, b) => String(a.heure_debut).localeCompare(String(b.heure_debut)));\n        const ferme = fermes[i] && fermes[i].ferme;\n        const weekend = i >= 5;\n        const body = ferme && !slots.length\n          ? '<p class=\"warn\" style=\"margin:0;padding:.2rem 0;font-size:.82rem\">Jour fermé</p>'\n          : (slots.length\n            ? slots.map(c => `<div class=\"edt-slot${edtSlotNowClass(j, c.heure_debut, c.heure_fin)}\">\n              <strong>${esc(c.heure_debut)}–${esc(c.heure_fin)}</strong>\n              <div>${esc(c.matiere_libelle)}</div>\n              <div class=\"muted\">${esc(c.salle || '—')}</div>\n            </div>`).join('')\n            : (weekend\n              ? eleveEdtWeekendDayBodyHtml()\n              : '<p class=\"empty\" style=\"margin:0;padding:.35rem 0\">—</p>'));\n        return `<div class=\"edt-day${weekend ? ' edt-day-weekend' : ''}${ferme ? ' edt-day-ferme' : ''}\">\n          <div class=\"edt-day-head\">${joursLib[i]} <span class=\"muted\">${esc(j.slice(8, 10))}/${esc(j.slice(5, 7))}</span>\n            ${ferme ? ' <span class=\"pill\">fermé</span>' : ''}${weekend ? ' <span class=\"pill muted\">WE</span>' : ''}</div>\n          ${body}\n        </div>`;\n      }).join('')}</div>`;\n    } catch (e) {\n      out.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n    }\n  }\n  document.getElementById('btnEleveEdt').onclick = load;\n  document.getElementById('btnEleveEdtJour').onclick = loadJourSeul;\n  document.getElementById('btnEleveEdtPrev').onclick = () => {\n    document.getElementById('eleveEdtJour').value = addDaysIso(mondayOf(document.getElementById('eleveEdtJour').value), -7);\n    load();\n  };\n  document.getElementById('btnEleveEdtNext').onclick = () => {\n    document.getElementById('eleveEdtJour').value = addDaysIso(mondayOf(document.getElementById('eleveEdtJour').value), 7);\n    load();\n  };\n  document.getElementById('eleveEdtJour').onchange = load;\n  const btnIcal = document.getElementById('btnEleveEdtIcal');\n  if (btnIcal && eid) {\n    btnIcal.onclick = async () => {\n      try {\n        const lundi = mondayOf(document.getElementById('eleveEdtJour').value || today());\n        const dimanche = addDaysIso(lundi, 6);\n        await downloadFile(\n          edtIcalPathEleve(eid, lundi, dimanche),\n          'edt-semaine.ics',\n        );\n        const joursW = [0, 1, 2, 3, 4].map(i => addDaysIso(lundi, i));\n        const listsW = await Promise.all(joursW.map(j =>\n          api('/eleves/' + eid + '/edt?jour=' + encodeURIComponent(j)).catch(() => [])\n        ));\n        const nCours = listsW.reduce((s, l) => s + (l || []).length, 0);\n        toastEdtIcalTelecharge('edt-semaine.ics', {\n          debut: lundi,\n          fin: dimanche,\n          mode: 'semaine',\n          nCours,\n        });\n      } catch (err) { alert(err.message); }\n    };\n  }\n  await loadVacList();\n  await load();\n}\n\n/* ---------- Accueil ---------- */\nfunction viewHome() {\n  const role = (me && me.role) || '';\n  const isAdminish = ['admin', 'direction', 'administratif'].includes(role);\n  let tiles = '';\n  let homeTitle = 'ENT';\n  let homeLead = `Espace métier — vue adaptée au rôle <strong>${esc(role || 'staff')}</strong>.`;\n  let homeExtra = '';\n  if (role === 'prof') {\n    tiles = `\n      <a class=\"stat-tile bento-span-4\" href=\"/app/appel\"><strong>Appel</strong><span>Mes créneaux du jour</span></a>\n      <a class=\"stat-tile bento-span-4\" href=\"/app/mon-edt\"><strong>Mon EDT</strong><span>Semaine + ouvrir appel</span></a>\n      <a class=\"stat-tile bento-span-4\" href=\"/app/cahier\"><strong>Cahier</strong><span>Publier le travail</span></a>\n      <a class=\"stat-tile bento-span-4\" href=\"/app/notes\"><strong>Saisir notes</strong><span>Grille classe &amp; devoirs</span></a>\n      <a class=\"stat-tile bento-span-4\" href=\"/app/messages\"><strong>Messages</strong><span>Fils familles</span></a>\n      <a class=\"stat-tile bento-span-4\" href=\"/app/rh\"><strong>RH</strong><span>Déclarer une absence</span></a>`;\n    homeExtra = `\n    <div class=\"panel\" style=\"margin-top:.75rem\">\n      <h3>Cockpit métier</h3>\n      <p class=\"muted\" style=\"margin-top:0\">EDT · cahier · annuaire · notes — repères du jour <span class=\"muted empty-state-hint\" style=\"font-size:.72rem\">BT-C</span>.</p>\n      <div id=\"homeStaffCockpitTip\" class=\"muted\">Chargement…</div>\n    </div>\n    <div class=\"panel\" style=\"margin-top:.75rem\">\n      <h3>Cockpit notes &amp; pédagogie</h3>\n      <p class=\"muted\" style=\"margin-top:0\">Périodes · devoirs · bulletins · stages · cahier — <span class=\"muted empty-state-hint\" style=\"font-size:.72rem\">CD-C</span>.</p>\n      <div id=\"homeStaffCdcTip\" class=\"muted\">Chargement…</