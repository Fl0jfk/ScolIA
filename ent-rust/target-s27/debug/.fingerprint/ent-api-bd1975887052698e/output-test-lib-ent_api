nse('Aucune entrée au cahier de texte', [\n          'Les consignes publiées par les professeurs (classe, matière, pour le…) apparaissent ici (BW-B).',\n          'Les devoirs planifiés et les notes sont sur la fiche enfant · sections Notes et Devoirs.',\n        ], '<button type=\"button\" class=\"primary\" id=\"btnCdtReloadEmpty\">Actualiser</button> · '\n          + `<a href=\"${famBwBNotesHrefForEnfant(eidDevoirs)}\">Notes</a>`)}`;\n      }\n      if (familleFace && eidDevoirs) {\n        let devoirs = [];\n        try {\n          devoirs = await api('/eleves/' + encodeURIComponent(eidDevoirs) + '/devoirs');\n        } catch {}\n        out.innerHTML = `\n          <h3 style=\"margin:0 0 .5rem\">Cahier de texte</h3>\n          ${cahierHtml}\n          <h3 style=\"margin:1.25rem 0 .5rem\">Devoirs &amp; contrôles</h3>\n          ${famCahierDevoirsListHtml(devoirs)}`;\n        const btnReload = document.getElementById('btnCdtReloadEmpty');\n        if (btnReload) btnReload.onclick = load;\n      } else {\n        out.innerHTML = cahierHtml;\n      }\n    } catch (e) {\n      out.innerHTML = `<div class=\"errbox\">${esc(e.message)}</div>`;\n    }\n  }\n\n  document.getElementById('btnCdtLoad').onclick = load;\n  if (eleveFace) {\n    const duEl = document.getElementById('cdtDu');\n    const auEl = document.getElementById('cdtAu');\n    if (duEl) duEl.onchange = load;\n    if (auEl) auEl.onchange = load;\n  }\n  const btnCreer = document.getElementById('btnCdtCreer');\n  if (btnCreer) {\n    btnCreer.onclick = async () => {\n      msg.textContent = '';\n      try {\n        const created = await api('/cahier-texte', {\n          method: 'POST',\n          body: JSON.stringify({\n            classe: document.getElementById('cdtClasse').value.trim(),\n            matiere_libelle: document.getElementById('cdtMatiere').value.trim(),\n            titre: document.getElementById('cdtTitre').value.trim(),\n            consigne: document.getElementById('cdtConsigne').value.trim(),\n            pour_le: document.getElementById('cdtPourLe').value,\n          }),\n        });\n        const famLink = ' · <a href=\"/famille/cahier\">Vue famille — cahier</a>';\n        let publishedMsg = '<span class=\"ok\">Publié — les familles voient le cahier</span>' + famLink;\n        let notifiedParents = false;\n        const entryId = created && created.id;\n        const titrePub = document.getElementById('cdtTitre').value.trim();\n        if (entryId) {\n          try {\n            await api('/cahier-texte/' + encodeURIComponent(entryId) + '/notify-parents', {\n              method: 'POST',\n              body: '{}',\n            });\n            notifiedParents = true;\n            publishedMsg = '<span class=\"ok\">Publié — les familles ont été notifiées</span>' + famLink;\n          } catch (notifyErr) {\n            const st = notifyErr && notifyErr.status;\n            if (st !== 404 && st !== 405 && st !== 501) {\n              publishedMsg = `<span class=\"ok\">Publié — les familles voient le cahier</span>${famLink}`\n                + ` <span class=\"muted\">(${esc(notifyErr.message || 'notification indisponible')})</span>`;\n            }\n          }\n        }\n        msg.innerHTML = publishedMsg;\n        toastCahierPublie({ titre: titrePub, notified: notifiedParents });\n        document.getElementById('cdtConsigne').value = '';\n        await load();\n      } catch (e) {\n        msg.innerHTML = `<span class=\"bad\">${esc(e.message)}</span>`;\n      }\n    };\n  }\n  if (staff) {\n    const matSel = document.getElementById('cdtMatiere');\n    if (matSel) {\n      try {\n        const mats = await api('/matieres');\n        matSel.innerHTML = (mats || []).map(m =>\n          `<option value=\"${esc(m.libelle)}\">${esc(m.code)} — ${esc(m.libelle)}</option>`\n        ).join('') || '<option value=\"Travail\">Travail</option>';\n      } catch (_) {\n        matSel.innerHTML = '<option value=\"Travail\">Travail</option>';\n      }\n    }\n    const classeEl = document.getElementById('cdtClasse');\n    if (classeEl) classeEl.onchange = load;\n    const pourEl = document.getElementById('cdtPourLe');\n    if (pourEl) pourEl.onchange = load;\n  }\n  if (!staff) {\n    try {\n      const enfants = await api('/famille/enfants');\n      const sel = document.getElementById('cdtEleve');\n      sel.innerHTML = enfants.map(e =>\n        `<option value=\"${esc(e.id)}\">${esc(e.prenom)} ${esc(e.nom)}</option>`\n      ).join('') || '<option value=\"\">—</option>';\n      sel.onchange = load;\n    } catch {}\n  }\n  await load();\n}\n\n/* ---------- EDT exceptions ---------- */\nfunction mondayOf(iso) {\n  const x = new Date((iso || today()) + 'T12:00:00');\n  const day = x.getDay();\n  const diff = day === 0 ? -6 : 1 - day;\n  x.setDate(x.getDate() + diff);\n  return x.toISOString().slice(0, 10);\n}\n\nfunction addDaysIso(iso, n) {\n  const x = new Date(iso + 'T12:00:00');\n  x.setDate(x.getDate() + n);\n  return x.toISOString().slice(0, 10);\n}\n\nfunction viewMonEdt() {\n  return shell('/app/mon-edt', `\n    <div id=\"monEdtCgcTip\"></div>\n    <div id=\"monEdtStats\"></div>\n    <div class=\"panel\">\n      <h2>Mon emploi du temps</h2>\n      <p class=\"muted\">Créneaux du jour / semaine — exceptions visibles · pose admin : <a href=\"/app/edt\">Emploi du temps</a>.</p>\n      <div class=\"row\">\n        <label>Jour <input id=\"monEdtJour\" type=\"date\" value=\"${today()}\"/></label>\n        <button type=\"button\" class=\"primary\" id=\"btnMonEdtJour\">Jour</button>\n        <button type=\"button\" id=\"btnMonEdtSemaine\">Semaine</button>\n        <button type=\"button\" id=\"btnMonEdtPrev\">←</button>\n        <button type=\"button\" id=\"btnMonEdtNext\">→</button>\n        <button type=\"button\" id=\"btnMonEdtIcal\">Exporter iCal</button>\n        <span id=\"monEdtMode\" class=\"muted\">jour</span>\n      </div>\n      <div id=\"monEdtOut\" class=\"muted\" style=\"margin-top:.75rem\">Chargement…</div>\n      <div id=\"monEdtExOut\" class=\"muted\" style=\"margin-top:.75rem\"></div>\n    </div>`);\n}\n\nasync function bindMonEdt() {\n  const out = document.getElementById('monEdtOut');\n  const stats = document.getElementById('monEdtStats');\n  const jourEl = document.getElementById('monEdtJour');\n  const modeEl = document.getElementById('monEdtMode');\n  let mode = 'jour';\n  async function load() {\n    const base = (jourEl && jourEl.value) || today();\n    const jours = mode === 'semaine'\n      ? [0, 1, 2, 3, 4].map(i => addDaysIso(mondayOf(base), i))\n      : [base];\n    if (modeEl) modeEl.textContent = mode === 'semaine' ? 'semaine' : 'jour';\n    out.textContent = 'Chargement…';\n    const exOut = document.getElementById('monEdtExOut');\n    if (exOut) exOut.textContent = '';\n    try {\n      const packs = await Promise.all(jours.map(async j => {\n        const ferme = await api('/vacances/jour-ferme?jour=' + encodeURIComponent(j)).catch(() => ({ ferme: false }));\n        const [list, exs] = await Promise.all([\n          api('/edt/mes-creneaux?jour=' + encodeURIComponent(j)),\n          api('/edt/exceptions?jour=' + encodeURIComponent(j)).catch(() => []),\n        ]);\n        return { jour: j, ferme: !!(ferme && ferme.ferme), list: list || [], exs: exs || [] };\n      }));\n      const total = packs.reduce((s, p) => s + p.list.length, 0);\n      const nEx = packs.reduce((s, p) => s + p.exs.length, 0);\n      const nFerme = packs.filter(p => p.ferme).length;\n      const flatLists = packs.map(p => p.list);\n      const flatJours = packs.map(p => p.jour);\n      const slotPairs = [];\n      packs.forEach(p => {\n        (p.list || []).forEach(c => {\n          slotPairs.push({\n            jour: p.jour,\n            c,\n          });\n        });\n      });\n      const { current, next } = eleveEdtPickCurrentAndNext(flatLists, flatJours);\n      const curSlot = current\n        ? { ...current, classe: slotPairs.find(x => x.jour === current.jour && x.c.heure_debut === current.heure_debut)?.c?.classe }\n        : null;\n      const nxtSlot = next\n        ? {\n          ...next,\n          classe: slotPairs.find(x => x.jour === next.jour && x.c.heure_debut === next.heure_debut)?.c?.classe,\n        }\n        : null;\n      const monEdtTipOpts = {\n        mode,\n        jour: base,\n        lundi: mode === 'semaine' ? mondayOf(base) : '',\n        total,\n        nCours: mode === 'jour' ? total : total,\n        nEx,\n        nFerme,\n        current: curSlot,\n        next: nxtSlot,\n      };\n      const cgcMon = document.getElementById('monEdtCgcTip');\n      if (cgcMon) {\n        cgcMon.innerHTML = staffMonEdtPageCgcTipDenseHtml(monEdtTipOpts);\n        bindStaffMonEdtPageCgcTipActions(monEdtTipOpts);\n      }\n      if (stats) {\n        stats.innerHTML = staffMonEdtTipDenseHtml(monEdtTipOpts);\n      }\n      if (!total && packs.every(p => !p.ferme)) {\n        out.innerHTML = staffMonEdtEmptyHtml(mode);\n      } else {\n        out.innerHTML = packs.map(p => {\n          const exByC = Object.fromEntries((p.exs || []).map(e => [e.creneau_id, e]));\n          const head = `<h3 style=\"margin:1rem 0 .4rem\">${esc(p.jour)}${p.ferme ? ' <span class=\"warn\">· fermé</span>' : ''}${p.exs.length ? ' <span class=\"pill\">' + p.exs.length + ' ex.</span>' : ''}</h3>`;\n          if (p.ferme && !p.list.length) {\n            return head + '<p class=\"warn\" style=\"margin:0\">Jour fermé (vacances / férié)</p>';\n          }\n          if (!p.list.length) {\n            return head + staffMonEdtEmptyHtml('jour');\n          }\n          return head + `<table><thead><tr><th>Horaire</th><th>Classe</th><th>Matière</th><th>Salle</th><th>Exception</th><th></th></tr></thead>\n            <tbody>${p.list.map(c => {\n              const ex = exByC[c.id];\n              let badge = '—';\n              if (ex) {\n                if (ex.kind === 'annulation') badge = `<span class=\"warn\">annulé</span>`;\n                else if (ex.