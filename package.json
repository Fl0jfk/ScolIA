{
  "name": "docslapro",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=DEP0040' next dev --turbopack",
    "build": "next build",
    "start": "NODE_OPTIONS='--disable-warning=DEP0040' next start",
    "lint": "next lint",
    "test:ocr-match": "npx tsx --test app/lib/ocr-eleve-match.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:set-password": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/set-better-auth-password.ts",
    "auth:bulk-activation": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/bulk-send-password-activation.ts",
    "ent:import-core": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/import-ent-core.ts",
    "ent:migrate-relational": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/migrate-ent-relational.ts",
    "ent:migrate-requests-config": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/migrate-requests-config-typed.ts",
    "ent:import-json": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/import-ent-json.ts",
    "ent:normalize": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/normalize-ent-entities.ts",
    "seed:dev": "node --import tsx scripts/seed-dev-local.ts",
    "seed:dev:totp": "node --import tsx scripts/dev-totp-code.ts",
    "seed:edt-prof-test": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --require ./scripts/stub-server-only.cjs --import tsx scripts/seed-edt-prof-test.ts",
    "migrate:teacher-planning": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --require ./scripts/stub-server-only.cjs --import tsx scripts/migrate-teacher-planning.ts",
    "ent:import-internat": "node --require ./scripts/stub-server-only.cjs --import tsx scripts/import-internat-excel.ts"
  },
  "engines": {
    "node": ">=24.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@azure/msal-browser": "5.19.0",
    "@napi-rs/canvas": "1.0.8",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/postcss": "4.3.3",
    "better-auth": "1.7.2",
    "docx": "9.7.1",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "framer-motion": "13.1.1",
    "imapflow": "1.7.6",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "jszip": "3.10.1",
    "mailparser": "3.9.17",
    "next": "16.3.3",
    "nodemailer": "9.0.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "xlsx": "0.18.5",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@types/mailparser": "3.4.6",
    "@types/node": "26.4.0",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ajv": "8.18.0",
    "minimatch": "10.2.1",
    "eslint": "10.9.1"
  }
}
