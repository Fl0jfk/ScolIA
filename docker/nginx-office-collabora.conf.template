    resolver 1.1.1.1 8.8.8.8 valid=30s ipv6=off;

    location ^~ /cool/admin {
      return 404;
    }

    location ^~ /browser/ {
      set $office_upstream "__COLLABORA_SCHEME__://__COLLABORA_HOST__";

      location ~* /extensions/index\.json$ {
        default_type application/json;
        add_header Cache-Control "public, max-age=300";
        add_header X-Content-Type-Options nosniff;
        return 200 '[]';
      }

      # CODE n’embarque pas lc_spellonline.svg — on sert l’icône spelling existante.
      location ~* /images/lc_spellonline\.svg$ {
        rewrite ^(/browser/[^/]+/images/)lc_spellonline\.svg$ $1lc_spelling.svg last;
      }

      proxy_pass $office_upstream;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_ssl_name __COLLABORA_HOST__;
      proxy_set_header Host __COLLABORA_HOST__;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 86400s;
      proxy_buffering off;
    }

    location ^~ /cool/ {
      set $office_upstream "__COLLABORA_SCHEME__://__COLLABORA_HOST__";
      proxy_pass $office_upstream;
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_ssl_name __COLLABORA_HOST__;
      proxy_set_header Host __COLLABORA_HOST__;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_set_header X-Forwarded-Host $host;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_read_timeout 86400s;
      proxy_send_timeout 86400s;
      proxy_buffering off;
    }

    location ^~ /hosting/ {
      set $office_upstream "__COLLABORA_SCHEME__://__COLLABORA_HOST__";
      proxy_pass $office_upstream;
      proxy_ssl_server_name on;
      proxy_ssl_name __COLLABORA_HOST__;
      proxy_set_header Host __COLLABORA_HOST__;
    }
