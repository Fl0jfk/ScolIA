# PostgreSQL Scaleway (Managed Database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Better-Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://lpnb.scolia.fr
# Origines supplémentaires (CSV) si multi-domaines tenants
# BETTER_AUTH_TRUSTED_ORIGINS=https://lp.docslapro.com,https://lpnb.scolia.fr
# Vérif e-mail à l’inscription (défaut: true en production ; false pour forcer off)
# REQUIRE_EMAIL_VERIFICATION=true

# Auth provider : better-auth
AUTH_PROVIDER=better-auth

# Cœur ENT (Postgres) — activé dès que DATABASE_URL est défini.
# Mettre 0 uniquement pour forcer un repli d’urgence (déconseillé).
ENT_CORE_DB=1

# Dev local : slug tenant servi sur localhost (sinon « default » vide)
# DEFAULT_TENANT_SLUG=la-providence-nicolas-barre
