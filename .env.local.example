# PostgreSQL Scaleway (Managed Database)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Better-Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://lpnb.scolia.fr
# Origines supplémentaires (CSV) si multi-domaines tenants
# BETTER_AUTH_TRUSTED_ORIGINS=https://lp.docslapro.com,https://lpnb.scolia.fr

# Auth provider : better-auth (cible) | dual | legacy (désactivé)
AUTH_PROVIDER=better-auth

# Chemins pilote (uniquement si AUTH_PROVIDER=dual)
# BETTER_AUTH_PILOT_PATHS=/auth,/api/auth,/dashboard

# Auth legacy — packages retirés du runtime
# NEXT_PUBLIC_LEGACY_PUBLISHABLE_KEY=
# LEGACY_SECRET_KEY=

# Cœur ENT (Postgres) — activé dès que DATABASE_URL est défini.
# Mettre 0 uniquement pour forcer un repli d’urgence (déconseillé).
ENT_CORE_DB=1
