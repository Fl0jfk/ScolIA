# Copie ce fichier en mcp.local.env (gitignored), puis remplis les valeurs.
#
# Mistral — console Mistral → API keys
MISTRAL_API_KEY=your_mistral_api_key_here
#
# Scaleway Managed Database (PostgreSQL) — console Scaleway → Databases → Connection.
# Utilise de préférence un utilisateur lecture seule pour les tests.
MCP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
