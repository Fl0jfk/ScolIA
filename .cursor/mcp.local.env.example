# Copie en mcp.local.env (gitignored) ou laisse install.sh le générer depuis .env.local.
#
# Postgres MCP — préférer une URL lecture seule en prod ; en local = DATABASE_URL.
MCP_DATABASE_URL=postgresql://scola:scola_dev_pwd@127.0.0.1:5432/scola
#
# Mistral — console Mistral → API keys (optionnel pour OCR)
# MISTRAL_API_KEY=
#
# Scaleway CLI (optionnel) — aussi via secrets dashboard Cloud Agent :
# SCW_ACCESS_KEY=
# SCW_SECRET_KEY=
# SCW_DEFAULT_ORGANIZATION_ID=
# SCW_DEFAULT_PROJECT_ID=
# SCW_DEFAULT_REGION=fr-par
